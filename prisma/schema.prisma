generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { MD ARCHITECT PROJECT_HEAD EXECUTION_HEAD PROCESS_COORDINATOR PURCHASE_MANAGER }
enum ProjectStatus { RUNNING COMPLETED ON_HOLD }
enum TaskStatus { ON_TIME DELAYED COMPLETED }
enum ProjectPhase { INITIATION DESIGN FULL_KITTING EXECUTION FINISHING }

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  role     Role
  projects Project[] @relation("InchargeProjects")
  moms     MOM[]
}

model Project {
  id         String        @id @default(uuid())
  name       String
  status     ProjectStatus @default(RUNNING)
  inchargeId String
  incharge   User          @relation("InchargeProjects", fields: [inchargeId], references: [id])
  tasks      Task[]
  scopes     Scope[]
  moms       MOM[]
  phase      ProjectPhase @default(INITIATION)
  currentGate String?
  gateProgress Int        @default(0)
  budget       Decimal      @db.Decimal(18, 2)
  spent        Decimal      @default(0) @db.Decimal(18, 2)
}

model Task {
  id              String     @id @default(uuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  status          TaskStatus @default(ON_TIME)
  dueDate         DateTime
  lastUpdatedDate DateTime   @updatedAt
  phase           ProjectPhase
  taskCode        String?
  ownerName       String
  startDate       DateTime
  percentDone     Int        @default(0)
  actualEndDate   DateTime?
  formLink        String?
  frequency       String?
  isGate          Boolean    @default(false)
  gateApprovedAt  DateTime?
  closedById       String?
  closedByRole     Role?
  closedAt         DateTime?
  acknowledgedAt  DateTime?
  acknowledgedById String?
  photoUrls         String[]
}

model Scope {
  id                  String  @id @default(uuid())
  projectId           String
  project             Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawingFileUrl      String?
  workItemDescription String
}

model MOM {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meetingDate DateTime
  notes       String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}
